---
import { getCollection } from "astro:content";
import SystemPageLayout from "../../layouts/SystemPageLayout.astro";
import { getTopicRoute, getTopicSummaries } from "../../utils/posts";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const topics = getTopicSummaries(posts);
---
<SystemPageLayout
  title="Topics"
  moduleCode=""
  description="Browse the archive by topic."
  showDescription={false}
  active="topics"
>
  <div class="taxonomy-grid">
    {topics.map((topic, index) => (
      <a class="taxonomy-card" href={getTopicRoute(topic.name)}>
        <span class="taxonomy-index" aria-hidden="true">
          {String(index + 1).padStart(2, "0")}
        </span>
        <h2>{topic.name}</h2>
        <span class="taxonomy-card-footer">
          <span>{topic.count} posts</span>
          <span class="taxonomy-selector" aria-hidden="true">&gt;</span>
        </span>
      </a>
    ))}
  </div>
</SystemPageLayout>
