---
import BaseLayout from "../layouts/BaseLayout.astro";
import SystemHeader from "../components/SystemHeader.astro";
import "../styles/system.css";
import "../styles/pages/home.css";
---

<BaseLayout
  system
  themeColor="#050301"
  description="Personal notes on engineering, technology, and life."
>
  <div class="ascii-ocean-page">
    <SystemHeader active="home" />
    <section
      class="ascii-ocean-stage"
      data-ascii-ocean
      aria-labelledby="jelly-title"
      aria-describedby="jelly-description"
    >
      <h1 class="sr-only" id="jelly-title">Tien's Notes</h1>
      <p class="sr-only" id="jelly-description">
        A detailed colorful ASCII jellyfish slowly floats in darkness. Its bell pulses, ribbons fold, and tentacles respond to a changing simulated current.
      </p>
      <canvas data-jelly-canvas aria-hidden="true" hidden></canvas>
      <pre class="ascii-ocean-fallback" data-jelly-fallback aria-hidden="true">
