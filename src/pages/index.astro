---
import BaseLayout from "../layouts/BaseLayout.astro";
import SystemHeader from "../components/SystemHeader.astro";
import "../styles/system.css";
import "../styles/pages/home.css";
---

<BaseLayout
  system
  description="Engineering notes, little experiments, games, and occasional thoughts."
  socialTitle="Tien's Notes"
  socialDescription="Engineering notes, little experiments, games, and occasional thoughts."
>
  <div class="home-bonsai-page">
    <SystemHeader active="home" />
    <section class="home-bonsai-stage" aria-labelledby="home-title">
      <h1 class="sr-only" id="home-title">Mai vàng — a living ASCII bonsai</h1>
      <iframe
        class="home-bonsai-art"
        src="/mai-vang-bonsai.html"
        title="Glowing ASCII mai vàng bonsai with continuously falling and regrowing petals"
        loading="eager"
      ></iframe>
    </section>
  </div>
</BaseLayout>
