---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/components/number-game.css";
---
<BaseLayout title="Number" description="One hidden number. A shrinking range. Take turns and try not to hit it." >
  <section class="number-game" data-number-game data-backend-url={import.meta.env.PUBLIC_NUMBER_BACKEND_URL || ""} aria-labelledby="number-title">
    <header class="number-header">
      <a class="number-back" href="/">← HOME</a>
      <span class="number-caption" data-number-mode>PASS & PLAY</span>
    </header>
    <div class="number-online">
      <div class="number-online-actions" data-number-join-form>
        <button class="number-key" type="button" data-number-create disabled>CREATE</button>
        <button class="number-key" type="button" data-number-join disabled>JOIN</button>
      </div>
      <dialog class="number-dialog number-online-dialog" data-number-online-dialog aria-labelledby="number-online-title">
        <h2 id="number-online-title" data-number-online-title>Create room</h2>
        <form data-number-online-form novalidate>
          <label for="number-name">YOUR NAME
            <input id="number-name" class="number-invite" data-number-name maxlength="32" autocomplete="nickname" placeholder="1–16 characters" required />
          </label>
          <label for="number-code" data-number-code-field hidden>ROOM CODE
            <input id="number-code" class="number-invite" data-number-code inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="123456" autocomplete="off" />
          </label>
          <p class="number-online-status" data-number-dialog-status role="status" aria-live="polite"></p>
          <div class="number-online-actions">
            <button class="number-key" type="button" data-number-online-cancel>CANCEL</button>
            <button class="number-key number-key-enter" type="submit" data-number-online-submit>CREATE ROOM</button>
          </div>
        </form>
      </dialog>
      <div data-number-room hidden>
        <p class="number-room-code" data-number-room-code></p>
        <label class="number-caption" for="number-invite">INVITE LINK</label>
        <input id="number-invite" class="number-invite" data-number-invite readonly />
        <div class="number-options">
          <button class="number-option" type="button" data-number-copy>COPY INVITE</button>
          <button class="number-option" type="button" data-number-leave>LEAVE ROOM</button>
        </div>
        <details class="number-roster" open>
          <summary data-number-roster-title>PLAYERS</summary>
          <ol data-number-roster></ol>
        </details>
        <button class="number-key number-again" type="button" data-number-start disabled>START ROUND</button>
      </div>
      <p class="number-online-status" data-number-online-status role="status" aria-live="polite"></p>
    </div>
    <div class="number-heading">
      <p class="number-caption">ONE NUMBER ENDS THE ROUND</p>
      <h1 id="number-title">NUMBER<span aria-hidden="true">.</span></h1>
    </div>
    <div class="number-board">
      <div class="number-range-heading">
        <span class="number-caption">AVAILABLE RANGE</span>
        <span class="number-caption" data-number-count>99 NUMBERS LEFT</span>
      </div>
      <p class="number-range" data-number-range>0 — 100</p>
      <div class="number-track" aria-hidden="true">
        <div class="number-bar" data-number-bar>
          {Array.from({ length: 101 }, (_, i) => <span class="number-cell" data-number-cell={i}></span>)}
        </div>
        <div class="number-scale"><span>0</span><span>50</span><span>100</span></div>
      </div>
      <p class="number-status" data-number-status role="status" aria-live="polite" aria-atomic="true">Pick a number from 1 to 99.</p>
      <div class="number-play-area">
        <div data-number-controls>
          <div class="number-entry-row">
            <span class="number-caption">YOUR GUESS</span>
            <output class="number-entry" data-number-entry aria-label="Your guess" aria-live="polite">_</output>
          </div>
          <div class="number-keypad" aria-label="Number keypad">
            {[1, 2, 3, 4, 5, 6, 7, 8, 9].map(n => <button class="number-key" type="button" data-number-key={n} disabled>{n}</button>)}
            <button class="number-key number-key-delete" type="button" data-number-key="delete" aria-label="Delete last digit" disabled>DEL</button>
            <button class="number-key" type="button" data-number-key="0" disabled>0</button>
            <button class="number-key number-key-enter" type="button" data-number-key="enter" aria-label="Confirm guess" disabled>ENTER</button>
          </div>
        </div>
        <div class="number-result" data-number-result hidden>
          <p class="number-caption" data-number-outcome>YOU HIT IT</p>
          <p class="number-hit" data-number-hit></p>
          <p class="number-caption" data-number-summary></p>
          <button class="number-key number-again" data-number-again type="button">PLAY AGAIN ↵</button>
        </div>
      </div>
      <canvas class="number-explosion" data-number-explosion aria-hidden="true" hidden></canvas>
    </div>
    <div class="number-options">
      <button type="button" class="number-option" data-number-new disabled>NEW ROUND</button>
      <button type="button" class="number-option" data-number-sound aria-pressed="false" disabled>SOUND OFF</button>
    </div>
    <dialog class="number-dialog" data-number-dialog aria-labelledby="number-reset-title">
      <h2 id="number-reset-title">Start a new round?</h2>
      <p>The current number and range will be discarded.</p>
      <form method="dialog">
        <button class="number-key" value="cancel" autofocus>KEEP PLAYING</button>
        <button class="number-key number-key-enter" value="reset">NEW ROUND</button>
      </form>
    </dialog>
    <footer class="number-footer">
      <p>Take turns. Narrow the range. Avoid the hidden number.</p>
      <p class="number-caption">BOUNDARIES EXCLUDED · KEYBOARD OR TOUCH</p>
      <noscript>Enable JavaScript to play Number.</noscript>
    </footer>
  </section>
  <script>
    import { mountNumberGames } from "../../scripts/games/number";
    mountNumberGames();
  </script>
</BaseLayout>
