---
// A plain Astro page that serves the dependency-free game from public/games/unfold.
// Public URL from the Astro build (GitHub Actions must expose vars.PUBLIC_UNFOLD_BACKEND_URL).
const unfoldBackendUrl = (import.meta.env.PUBLIC_UNFOLD_BACKEND_URL || "").trim();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#070B14">
  <meta name="description" content="UNFOLD: unfold luminous six-panel modules to connect roads across a tactical neon grid.">
  <title>UNFOLD · Neon Grid</title>
  <link rel="stylesheet" href="/games/unfold/styles/foundation.css">
  <link rel="stylesheet" href="/games/unfold/styles/operator.css">
  <link rel="stylesheet" href="/games/unfold/styles/navigation.css">
  <meta name="unfold-room-api" content={import.meta.env.PUBLIC_UNFOLD_BACKEND_URL || ""}>
  <script is:inline src="/games/unfold/room-config.js"></script>
  <script define:vars={{ unfoldBackendUrl }}>
    // GitHub Actions may pass PUBLIC_UNFOLD_BACKEND_URL to Astro at build time.
    if (unfoldBackendUrl) window.UNFOLD_ROOM_API = unfoldBackendUrl.replace(/\/$/, '');
  </script>
    <script is:inline>
    // UNFOLD GitHub Pages backend fallback; build variable wins when available.
    if (location.hostname === 'tiendu.github.io' && !window.UNFOLD_ROOM_API)
      window.UNFOLD_ROOM_API = 'https://unfold-multiplayer.tiendu107.workers.dev';
  </script>
<script is:inline type="module">
    import('/games/unfold/app.mjs').catch(error => {
      console.error('UNFOLD failed to load',error);
      const message=document.getElementById('boot-note');
      if(message)message.textContent=`Could not load the game: ${error.message}`;
    });
  </script>
</head>
<body>
  <div class="shell">
    <header class="masthead">
      <a href="/games/" class="back" aria-label="Back to games"><svg class="unfold-back-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 5 4 12l7 7M4 12h16"/></svg><span>GAMES</span></a>
      <div class="brand"><span class="brand-mark"><svg class="game-symbol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m12 2 9 5v10l-9 5-9-5V7zM3 7l9 5 9-5m-9 5v10"/></svg></span> UNFOLD </div>

      <button id="new-game" class="frame-new" type="button">NEW</button>
    </header>

    <section id="setup" class="setup" aria-labelledby="setup-title">
      <div class="menu-hero">
        <p class="menu-overline">SIGNAL / TACTICAL CONSTRUCTION</p>
        <h1 id="setup-title" class="setup-title">UNFOLD</h1>
        <p class="menu-lead">Build a path. Unfold the grid.</p>
        <div class="menu-steps"><span><b>01</b> ROLL</span><span><b>02</b> UNFOLD</span><span><b>03</b> CONNECT</span></div>
      </div>
      <div class="entry-tabs" role="tablist" aria-label="How to play">
        <button id="tab-solo" tabindex="0" class="active" type="button" role="tab" aria-selected="true" aria-controls="start-form"><svg class="menu-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h16v11H4z"/><path d="M8 11h5m-2.5-2.5v5M17 11h2m-1 4h0"/></svg><span class="menu-tab-name">PLAY LOCAL</span><small>Solo puzzles or pass-and-play · Offline</small></button>
        <button id="tab-create" tabindex="-1" type="button" role="tab" aria-selected="false" aria-controls="room-entry"><svg class="menu-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M12 8v8m-4-4h8"/></svg><span class="menu-tab-name">CREATE ROOM</span><small>Host an online Co-op or Versus match</small></button>
        <button id="tab-join" tabindex="-1" type="button" role="tab" aria-selected="false" aria-controls="room-entry"><svg class="menu-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 12h12m-4-4 4 4-4 4"/><path d="M13 5h6a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-6"/></svg><span class="menu-tab-name">JOIN ROOM</span><small>Enter a six-digit invite code</small></button>
      </div>
      <form id="start-form">
        <div class="menu-fields">
          <div class="menu-field">
            <label for="mode">Game mode</label>
            <select id="mode"><option value="solo">Solo — one player</option><option value="coop">Co-op — connect together</option><option value="competitive">Versus — capture opponents</option></select>
            <span class="menu-field-help">Choose how you want to build your network.</span>
          </div>
          <div id="level-options" class="menu-field">
            <label for="level">Map difficulty</label>
            <select id="level"><option value="starter">Starter</option><option value="standard" selected>Standard</option><option value="hard">Hard</option><option value="open">Open field</option></select>
            <span class="menu-field-help">Start with Starter if you're learning.</span>
          </div>
          <div id="local-options" class="menu-field" hidden>
            <label for="players">Local players</label>
            <select id="players"><option value="2">2 players</option><option value="3">3 players</option><option value="4">4 players</option></select>
            <span class="menu-field-help">Pass the device after each turn.</span>
          </div>
        </div>
        <details class="advanced"><summary>Advanced · repeat a board with a seed</summary><label for="seed">Board seed (optional)</label><input type="number" id="seed" placeholder="Random" min="1" max="4294967295"></details>
        <button id="play" class="primary" type="submit" disabled>Loading…</button>
        <p id="boot-note" class="small-note" role="status">Loading game…</p>
      </form>
      <button id="resume" class="quiet" type="button" hidden>CONTINUE GAME</button>
      <section id="room-entry" class="room-entry" aria-label="Online multiplayer" hidden>
        <div class="menu-field"><label for="room-name">Your name</label><input id="room-name" maxlength="22" autocomplete="nickname" placeholder="Player name" value="Player"></div>
        <div id="room-create-fields">
          <div class="menu-field"><label for="room-mode">Match mode</label><select id="room-mode"><option value="coop">Co-op — connect all bases</option><option value="competitive">Versus — conquer opponents</option></select></div>
          <button id="create-room" type="button" class="primary">CREATE ROOM</button>
        </div>
        <div id="room-join-fields" hidden>
          <label for="join-code">Six-digit room code</label>
          <div class="join-control"><input id="join-code" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" placeholder="000000" aria-label="Six-digit room code"><button id="join-room" class="primary" type="button">JOIN ROOM</button></div>
        </div>
        <p id="room-entry-note" class="small-note" role="status">2–4 players · Share a private room code with friends</p>
      </section>
    </section>

    <section id="room-lobby" class="room-lobby" hidden>
      <p class="eyebrow">ONLINE MATCH</p>
      <h2>ROOM <span id="lobby-code">------</span></h2>
      <p id="lobby-mode">CO-OP</p>
      <div class="lobby-buttons"><button id="copy-room" type="button">COPY INVITE LINK</button><button id="leave-room" type="button">LEAVE</button></div>
      <div id="lobby-seats" class="lobby-seats" aria-live="polite"></div>
      <button id="start-room" type="button" class="primary" hidden>START MATCH</button>
      <p id="lobby-hint" role="status">Waiting for players…</p>
    </section>
    <main id="game" hidden>
      <section class="play-area" aria-label="Assembly table">
        <div id="board-note" class="board-note" aria-label="Current game status">
          <div class="board-note-mode"><span id="mode-label" class="eyebrow">SOLO · STANDARD · 15×15 · TURN 1</span></div>
          <div class="board-note-mission"><strong id="mission-title">Connect S to ★</strong><span id="board-hint">Ready</span></div>
        </div>
        <p id="instruction" class="instruction-live" role="status" aria-live="polite">Roll the action reel.</p>
        <div class="table-rig">
          <div class="desktop-play-grid">
          <div class="board-frame" id="board-frame">
            <div class="board-corner c-tl" aria-hidden="true"></div><div class="board-corner c-tr" aria-hidden="true"></div>
            <div class="board-corner c-bl" aria-hidden="true"></div><div class="board-corner c-br" aria-hidden="true"></div>
            <button id="zoom-fit" class="frame-fit" type="button" aria-label="Fit entire board to view" title="Reset camera to fit">FIT</button>
            <div id="board-viewport" class="board-viewport">
              <div id="board-surface" class="board-surface">
                <div id="board" class="board" role="grid" aria-describedby="instruction" aria-label="Tactical grid with illuminated roads, obstacles, bases and electric gates"></div>
                <div id="fold-stage" class="fold-stage" hidden aria-hidden="true"></div>
                <div id="grit-layer" class="grit-layer" aria-hidden="true"></div>
              </div>
              <div id="placement-tools" class="context-tools" role="toolbar" aria-label="Guided placement controls" hidden>
                <div class="context-toolbar-label"><span>MODULE <b id="context-cube">01</b></span><span id="fit-count" class="fit-count">1 / 1 FITS</span></div>
                <div class="context-toolbar-keys">
                  <button id="next-fit" class="context-next" type="button">↻ NEXT FIT</button>
                  <button id="confirm" class="context-confirm" type="button" disabled>✓ UNFOLD</button>
                </div>
                <span id="placement-info" class="context-placement-info" role="status">Choose a highlighted socket.</span>
              </div>
            </div>
          </div>
            <aside class="command-rail" aria-label="Current action and controls">
          <div id="turn-banner" class="turn-banner"><span id="turn-label">YOUR TURN</span><strong id="turn-player">PLAYER 1</strong><span id="turn-clock">SOLO</span></div>
          <div class="frame-command" aria-label="Mechanical action selector attached to the table">
            <div class="frame-status">
              <div class="frame-turn"><strong id="roll-count">TURN 1 · REEL</strong><span id="clock-box" class="clock" hidden><strong id="clock">60</strong><small>SEC</small></span></div>
              <div class="reel-scene" role="img" aria-label="Six-stop public action reel: Deploy, Deploy, Super Deploy, Reclaim, Reclaim, Refold">
                <span id="current-action-icon" class="current-action-icon" aria-hidden="true"></span><div class="reel-window"><span class="reel-pointer" aria-hidden="true">▸</span><div id="reel-track" class="reel-track"><span>DEPLOY</span></div></div>
                <span class="reel-mark">ACTION REEL</span>
              </div>
              <strong id="rolled-action" class="reel-action">ROLLING</strong>
              <button id="frame-skip" class="frame-skip" type="button" disabled>SKIP ↷</button>
            </div>
            <div id="desktop-placement-slot" aria-label="Desktop placement controls"></div>
            <p id="action-tip" class="action-tip">Select a highlighted square to make your move.</p>
          </div>
          <div id="board-shape-slot" class="board-shape-slot" hidden>
            <div id="cube-offer" class="cube-offer" hidden>
              <div id="cube-visual" class="cube-visual"></div>
              <div class="cube-description"><strong id="cube-name">NET 01 · FIXED</strong><span id="cube-help">Tap any marked socket</span></div>
            </div>
            <div id="shape-picker" class="shape-picker" hidden>
              <div class="picker-head"><strong>SUPER / REFOLD: CHOOSE NET</strong><span>11 shapes · swipe</span></div>
              <div id="shape-list" class="shape-list" aria-label="Choose one of eleven cube nets"></div>
            </div>
          </div>
            <div class="grid-legend" aria-label="Board symbols">
              <strong>GRID LEGEND</strong>
              <span class="legend-pair"><svg class="game-symbol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><path d="M12 1v5M12 18v5M1 12h5m12 0h5"/></svg> Base</span>
              <span class="legend-pair"><svg class="game-symbol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m12 2 3.5 6.5L22 12l-6.5 3.5L12 22l-3.5-6.5L2 12l6.5-3.5z"/><circle cx="12" cy="12" r="2.5"/></svg> Goal</span>
              <span class="legend-pair"><svg class="game-symbol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="4" width="16" height="16" rx="1"/><path d="m7 7 10 10M17 7 7 17"/></svg> Rubble</span>
              <span class="legend-pair"><svg class="game-symbol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 3v18M21 3v18M7 5v14m5-14v14m5-14v14"/><path d="M4 12h16"/></svg> Gate</span>
            </div>
          <div id="result" class="result" role="status" aria-live="polite" hidden>
            <strong id="result-title">ROUTE COMPLETE</strong>
            <button id="next-game" class="primary" type="button">NEXT →</button>
          </div>
        <details class="game-options"><summary>HOW TO PLAY &amp; SETTINGS</summary>
          <label for="animation-speed">Unfold speed</label>
          <select id="animation-speed"><option value="normal">Normal · 1.6s</option><option value="quick">Quick · 0.7s</option><option value="instant">Instant</option></select>
          <div class="camera-options" aria-label="Optional camera controls">
            <span>CAMERA</span>
            <button id="zoom-out" type="button" aria-label="Zoom out">−</button>
            <button id="zoom-in" type="button" aria-label="Zoom in">+</button>
            <output id="zoom-level" aria-live="off">100%</output>
          </div>
          <p>Roll one action per turn. Tap any marked socket, cycle legal layouts using NEXT FIT, then UNFOLD. Super Deploy lets you select any of the 11 nets. Reclaim and Refold require an eligible target. Skip forfeits a legal roll. An impossible construction roll causes a loss (Co-op: teammates get a turn each to clear it). Connect the + and − terminals with one base-powered road to open a steel gate permanently.</p>
        </details>
            </aside>
          </div>
        </div>
        <p id="room-game-note" class="room-game-note" role="status" hidden></p>
      </section>
    </main>
    <footer>UNFOLD / NEON GRID · BUILD THE CONNECTION</footer>
  </div>
</body>
</html>
