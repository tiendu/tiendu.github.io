---
import '../../../styles/pages/wisp.css';
const api = (import.meta.env.PUBLIC_WISP_BACKEND_URL || (import.meta.env.DEV ? 'http://127.0.0.1:8787' : '')).trim();
const gameURL = `/games/wisp/play.html${api ? '?api=' + encodeURIComponent(api) : ''}`;
---
<html lang="en"><head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#090d19" />
  <meta name="description" content="A neon maze chase. Play solo, co-op or competitive." />
  <title>WISP · Maze Chase</title>
</head><body>
  <iframe id="wisp-game" src={gameURL} title="WISP — maze chase"></iframe>
</body></html>
