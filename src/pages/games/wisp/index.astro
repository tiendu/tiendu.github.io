---
// The SVG-heavy browser game stays independent of Astro's build pipeline.
// This matches the existing static-game pattern without affecting other games.
// This is the same Cloudflare account subdomain as the site's UNFOLD worker.
// PUBLIC_WISP_BACKEND_URL overrides it for other accounts/deployments.
const workerURL=(import.meta.env.PUBLIC_WISP_BACKEND_URL ||
  (import.meta.env.PROD?'https://wisp-multiplayer.tiendu107.workers.dev':'http://127.0.0.1:8787')).trim();
const gameURL=`/games/wisp/play.html${workerURL?'?api='+encodeURIComponent(workerURL):''}`;
---
<html lang="en"><head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#081c23" />
  <meta name="description" content="WISP: a polygonal endless forest survival race. Run, jump, glide and escape the wildfire, solo or with friends." />
  <title>WISP · Forest Survival</title>
  <style>html,body{margin:0;background:#081c23;height:100%;overflow:hidden} iframe{display:block;width:100%;height:100dvh;border:0}</style>
</head><body>
  <iframe id="wisp-game" src={gameURL} title="WISP — forest survival game" allow="fullscreen"></iframe>
  <script is:inline>
    const iframe=document.getElementById('wisp-game');
    const parentQuery=new URLSearchParams(location.search);
    const room=parentQuery.get('room');
    if(room&&/^\d{6}$/.test(room)){
      const game=new URL(iframe.src);game.searchParams.set('room',room);iframe.src=game.toString();
    }
  </script>
</body></html>
