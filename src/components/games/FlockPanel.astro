---
import SoundToggle from "./shared/SoundToggle.astro";
import "../../styles/components/flock.css";
---
<section class="flock" aria-label="Chicken Run" hidden data-flock data-endpoint={import.meta.env.PUBLIC_CHICKEN_BACKEND_URL || ""}>
<header><button type="button" data-flock-exit>← Exit</button><SoundToggle /></header>
<div class="flock-marquee">
  <h1>Chicken Run</h1>
  <canvas data-poster width="288" height="88" aria-hidden="true"></canvas>
</div>
<section data-modes class="flock-actions">
  <button data-solo>Solo</button><button data-friends>Play with friends</button>
</section>
<section data-setup hidden>
<label>Your name <input data-name maxlength="16" placeholder="Player" autocomplete="nickname" /></label>
<div class="flock-actions"><button data-create>Create room</button><button data-join>Join room</button></div>
<form data-code-form hidden><label>Room code <input data-code inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required /></label><button>Join</button></form>
</section>
<p class="flock-rotate">Rotate your phone to landscape for the multiplayer race.</p>
<section data-lobby hidden>
<h2 data-room></h2><div data-picks class="flock-picks" aria-label="Choose your chicken"></div>
<ul data-roster></ul>
<button data-invite>Copy invite</button> <button data-start>Start race</button>
</section>
<section data-board hidden>
<canvas aria-label="Chicken race course" width="720" height="256"></canvas>
<div class="flock-hud"><button data-sprint>Sprint</button><span>Stamina <meter data-energy min="0" max="3" value="3"></meter></span><button data-jump>Jump / Flap</button></div>
</section>
<p role="status" data-status>Reach the coop. Press → or swipe right to sprint. Space or tap to jump.</p>
<button data-back hidden>← Back</button>
<button data-leave hidden>Leave room</button>
</section>
