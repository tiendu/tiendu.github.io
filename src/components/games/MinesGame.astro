---
import "../../styles/components/mines.css";
import "../../styles/components/mines-markers.css";
---
<main class="mines" data-backend={import.meta.env.PUBLIC_MINES_BACKEND_URL || ""}>
  <header><a href="/games/">← GAMES</a><span>SOLO · CO-OP 2–5</span></header>
  <h1>MINES<span>.</span></h1>
  <form id="entry">
    <p>Dig from your pennant. Reach the exit. Dig up the copper fuse to survive one mine. In co-op, connect every pennant.</p>
    <label>Name for online play <input id="name" maxlength="16" autocomplete="nickname" required /></label>
    <label id="code-label" hidden>Room code <input id="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="000000" /></label>
    <div class="actions"><button type="button" id="solo">Play solo</button><button id="create">Create room</button><button id="join" type="button">Join room</button></div>
  </form>
  <section id="lobby" hidden>
    <div class="actions"><strong id="room-label"></strong><button id="invite">Copy invite</button><button id="leave">Leave</button></div>
    <div id="crew" aria-label="Players"></div>
    <div class="actions"><button id="start">Start round</button><button id="finish" hidden>Take the win</button></div>
  </section>
  <section id="field" hidden>
    <p id="turn" role="status" hidden></p>
    <div class="actions"><button id="pass" hidden>Pass turn</button><button id="dig" aria-pressed="true">Dig</button><button id="flag" aria-pressed="false">Flag</button><strong id="fuses"></strong><button id="locate-fuse" type="button" hidden>Show fuse</button></div>
    <div id="victory" hidden></div>
    <div id="viewport" tabindex="0" aria-label="Scrollable minefield"><div id="tiles"></div></div>
    <p><span id="step-help">Dig up, down, left, or right from your patch.</span> Numbers count mines in the eight surrounding tiles. <span id="ping-help">Tap an open clue to ping it.</span></p>
  </section>
  <p id="status" role="status"></p>
</main>
