---
import SoundToggle from '../shared/ui/SoundToggle.astro';
import './six.css';
---
<main class="six" data-six data-backend={import.meta.env.PUBLIC_SIX_BACKEND_URL || ''}>
  <header class="six-topbar">
    <a href="/games/" class="six-home">← GAMES</a>
    <span class="six-mode-label">SOLO · ONLINE 2–20</span>
    <strong class="six-mini-brand" aria-hidden="true">SIX.</strong>
    <span class="six-mobile-progress" data-mobile-progress></span>
    <SoundToggle class="six-sound-toggle" />
  </header>

  <div class="six-heading">
    <div>
      <h1>SIX<span>.</span></h1>
      <p class="six-intro">One die. Three choices. Don’t go negative.</p>
    </div>
    <span class="six-progress" data-progress>CHOOSE A MODE</span>
  </div>

  <div class="six-shell">
    <div class="six-main">
      <section class="six-menu six-panel" data-menu aria-labelledby="six-welcome">
        <p class="six-eyebrow">READY TO ROLL?</p>
        <h2 id="six-welcome">Guess the next die.</h2>
        <p>Higher, lower, or a risky tie. Correct guesses earn points; wrong guesses cost points after the first round. Below zero? You're out.</p>
        <div class="six-match-options">
          <div class="six-dice-setting" aria-label="Solo die selection">
            <span>DIE <small data-solo-dice-note>D12 · TIE JACKPOT +36</small></span>
            <div class="six-dice-selector" role="group" aria-label="Choose solo die">
              <button type="button" data-dice-select="solo:6" aria-pressed="false">D6</button>
              <button type="button" data-dice-select="solo:12" aria-pressed="true">D12</button>
              <button type="button" data-dice-select="solo:20" aria-pressed="false">D20</button>
            </div>
          </div>
          <div class="six-round-setting" aria-label="Solo match length">
          <span>ROUNDS <small>DEFAULT 10 · 1–99</small></span>
          <div class="six-stepper">
            <button type="button" data-adjust="solo:-1" aria-label="Fewer solo rounds">−</button>
            <input data-solo-rounds type="number" min="1" max="99" step="1" inputmode="numeric" value="10" aria-label="Solo rounds" />
            <button type="button" data-adjust="solo:1" aria-label="More solo rounds">+</button>
          </div>
          </div>
        </div>
        <button class="six-primary six-solo-button" type="button" data-solo>PLAY VS COMPUTER <span aria-hidden="true">↗</span></button>
        <div class="six-separator"><span>OR PLAY WITH FRIENDS</span></div>
        <label class="six-field">YOUR NAME <input data-name maxlength="16" placeholder="Player" autocomplete="nickname" /></label>
        <div class="six-actions">
          <button type="button" data-create>CREATE ROOM</button>
          <button type="button" data-join>JOIN ROOM</button>
        </div>
        <label class="six-field" data-code-label hidden>ROOM CODE
          <input data-code inputmode="numeric" maxlength="6" pattern="[0-9]{6}" placeholder="123456" />
        </label>
      </section>

      <section class="six-room six-panel" data-room hidden aria-label="Online room">
        <div class="six-room-label"><span class="six-eyebrow">ONLINE ROOM</span><strong data-room-code></strong></div>
        <div class="six-actions">
          <button type="button" data-invite>COPY INVITE</button>
          <button type="button" data-leave>LEAVE ROOM</button>
        </div>
        <div class="six-match-options" data-room-settings aria-label="Online match settings">
          <div class="six-dice-setting" aria-label="Room die selection">
            <span>DIE <small data-online-dice-note>D12 · TIE JACKPOT +36</small></span>
            <div class="six-dice-selector" role="group" aria-label="Choose room die">
              <button type="button" data-dice-select="online:6" aria-pressed="false" disabled>D6</button>
              <button type="button" data-dice-select="online:12" aria-pressed="true" disabled>D12</button>
              <button type="button" data-dice-select="online:20" aria-pressed="false" disabled>D20</button>
            </div>
          </div>
          <div class="six-round-setting" aria-label="Online match length">
          <span>ROUNDS <small data-settings-note>HOST CHOOSES · 1–99</small></span>
          <div class="six-stepper">
            <button type="button" data-adjust="online:-1" aria-label="Fewer online rounds" disabled>−</button>
            <input data-online-rounds type="number" min="1" max="99" step="1" inputmode="numeric" value="10" aria-label="Online rounds" disabled />
            <button type="button" data-adjust="online:1" aria-label="More online rounds" disabled>+</button>
          </div>
          </div>
        </div>
        <button class="six-primary" type="button" data-start hidden>START GAME</button>
      </section>

      <section class="six-stage six-panel" data-stage hidden aria-label="SIX game board">
        <div class="six-mobile-scorebar" aria-label="Current scores">
          <span class="six-mobile-score-item"><span data-mobile-left-label>YOU</span><strong data-mobile-left-value>0</strong></span>
          <strong class="six-mobile-turn" data-mobile-turn aria-live="polite">YOUR TURN</strong>
          <span class="six-mobile-score-item six-mobile-score-right"><span data-mobile-right-label>COMPUTER</span><strong data-mobile-right-value>0</strong></span>
        </div>
        <div class="six-turn-row">
          <div>
            <span class="six-eyebrow">AT THE TABLE</span>
            <h2 class="six-turn" data-turn aria-live="polite"></h2>
          </div>
          <div class="six-your-score" data-your-score hidden>
            <span>YOUR SCORE</span>
            <strong data-my-points>0</strong>
          </div>
        </div>

        <div class="six-dice-table">
          <div class="six-dice-context">
            <span class="six-eyebrow" data-dice-label>PREVIOUS ROLL</span>
            <strong class="six-dice-value" data-dice-value>—</strong>
            <span class="six-dice-jackpot" data-jackpot-hint>D12 · TIE +36</span>
          </div>
          <div class="six-die-frame">
            <div class="six-die" data-die aria-hidden="true"></div>
          </div>
          <div class="six-result" data-result role="status" aria-live="polite" aria-atomic="true">
            <p data-last>Choose your prediction.</p>
          </div>
        </div>

        <div class="six-play-controls">
          <p class="six-eyebrow">WHAT COMES NEXT?</p>
          <div class="six-choices" data-choices>
            <button type="button" data-guess="higher" aria-label="Guess higher than the previous die">
              <span class="six-choice-symbol" aria-hidden="true">+</span>
              <span class="six-choice-title">HIGHER</span>
              <small>ROLL IS GREATER</small>
            </button>
            <button type="button" data-guess="lower" aria-label="Guess lower than the previous die">
              <span class="six-choice-symbol" aria-hidden="true">−</span>
              <span class="six-choice-title">LOWER</span>
              <small>ROLL IS SMALLER</small>
            </button>
            <button type="button" data-guess="tie" aria-label="Guess the same number for the fixed TIE jackpot">
              <span class="six-choice-symbol" aria-hidden="true">=</span>
              <span class="six-choice-title">TIE <span class="six-multiplier" data-tie-jackpot>+36</span></span>
              <small>SAME NUMBER</small>
            </button>
          </div>
        </div>
        <details class="six-mobile-roster" data-mobile-roster>
          <summary><strong>PLAYERS</strong><span data-mobile-summary>VIEW SCORES</span></summary>
          <ol data-mobile-scores aria-label="Mobile player scores"></ol>
        </details>
        <details class="six-mobile-history" data-mobile-history>
          <summary>RECENT ROLLS</summary>
          <ol data-mobile-history-list aria-label="Recent rolls on mobile"></ol>
        </details>
        <details class="six-match-actions" data-match-actions open>
          <summary>OPTIONS</summary>
          <div class="six-stage-footer">
            <button type="button" data-replay hidden>↻ RESTART MATCH</button>
            <button type="button" data-back hidden>CHANGE MODE</button>
            <p data-replay-hint hidden>Waiting for the host to start another match.</p>
          </div>
        </details>
      </section>

      <p class="six-status" data-status role="status" aria-live="polite"></p>
    </div>

    <aside class="six-sidebar" aria-label="Match information">
      <section class="six-scores six-panel" aria-labelledby="six-score-title">
        <div class="six-sidebar-head">
          <h2 id="six-score-title">PLAYERS</h2>
          <span data-player-count>0 / 20</span>
        </div>
        <p class="six-now-playing" data-now-playing>Waiting for a game</p>
        <ol data-scores aria-label="Player scores">
          <li class="six-empty">Scores will appear here.</li>
        </ol>
      </section>
      <section class="six-history six-panel" aria-labelledby="six-history-title">
        <div class="six-sidebar-head"><h2 id="six-history-title">RECENT ROLLS</h2></div>
        <ol data-history aria-label="Recent roll history"><li class="six-empty">No rolls yet.</li></ol>
      </section>
    </aside>
  </div>
  <footer><span data-rounds>10 ROUNDS DEFAULT</span> · BELOW ZERO = OUT · <span data-tie-rule>TIE JACKPOT +36</span></footer>
</main>
