{
  "name": "six-multiplayer",
  "main": "src/six-worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {"ALLOWED_ORIGINS": "https://tiendu.github.io", "MAX_ROOMS": "45"},
  "durable_objects": {"bindings": [{"name":"ROOMS","class_name":"SixRoom"},{"name":"LOBBY","class_name":"SixLobby"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["SixRoom","SixLobby"]}],
  "observability": {"enabled":false},
  "ratelimits": [{"name":"CREATE_LIMIT","namespace_id":"6001","simple":{"limit":10,"period":60}},{"name":"CONNECT_LIMIT","namespace_id":"6002","simple":{"limit":120,"period":60}}]
}
