{
  "name": "number-multiplayer",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://tiendu.github.io",
    "MAX_ROOMS": "50"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "NumberRoom"
      },
      {
        "name": "LOBBY",
        "class_name": "RoomLobby"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "NumberRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "RoomLobby"
      ]
    }
  ],
  "observability": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "CREATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "CONNECT_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
