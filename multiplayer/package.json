{
  "name": "number-multiplayer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:number --",
    "dev:number": "wrangler dev --config wrangler.number.jsonc",
    "dev:mines": "wrangler dev --config wrangler.mines.jsonc",
    "deploy:mines": "wrangler deploy --config wrangler.mines.jsonc",
    "check:mines": "node --test ../src/games/mines/tests/mines*.test.mjs && wrangler deploy --config wrangler.mines.jsonc --dry-run",
    "dev:six": "wrangler dev --config wrangler.six.jsonc",
    "deploy:six": "wrangler deploy --config wrangler.six.jsonc",
    "check:six": "node --test ../src/games/six/tests/*.test.mjs && wrangler deploy --config wrangler.six.jsonc --dry-run",
    "deploy": "npm run deploy:number --",
    "deploy:number": "wrangler deploy --config wrangler.number.jsonc",
    "check": "npm run check:number",
    "check:number": "node --check src/index.mjs && npm test && wrangler deploy --config wrangler.number.jsonc --dry-run",
    "test": "node --test ../src/games/number/tests/rules.test.mjs ../src/games/number/tests/room.test.mjs",
    "test:integration": "node --test ../src/games/number/tests/integration.test.mjs",
    "start": "node src/node-server.mjs",
    "test:node": "NUMBER_TEST_BACKEND=node node --test ../src/games/number/tests/integration.test.mjs ../src/games/number/tests/node.test.mjs",
    "check:unfold": "node --test ../src/games/unfold/tests/*.mjs",
    "deploy:unfold": "wrangler deploy --config wrangler.unfold.jsonc",
    "dev:unfold": "wrangler dev --config wrangler.unfold.jsonc",
    "test:wisp": "node --test ../src/games/wisp/tests/*.test.mjs",
    "check:wisp": "npm run test:wisp && wrangler deploy --config wrangler.wisp.jsonc --dry-run",
    "dev:wisp": "wrangler dev --config wrangler.wisp.jsonc",
    "deploy:wisp": "wrangler deploy --config wrangler.wisp.jsonc",
    "smoke:wisp": "node scripts/wisp-smoke.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=24"
  }
}
