{
  "name": "number-multiplayer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:number --",
    "dev:number": "wrangler dev --config wrangler.number.jsonc",
    "dev:mines": "wrangler dev --config wrangler.mines.jsonc",
    "deploy:mines": "wrangler deploy --config wrangler.mines.jsonc",
    "check:mines": "node --test test/mines*.test.mjs && wrangler deploy --config wrangler.mines.jsonc --dry-run",
    "dev:chicken": "wrangler dev --config wrangler.chicken.jsonc",
    "deploy": "npm run deploy:number --",
    "deploy:number": "wrangler deploy --config wrangler.number.jsonc",
    "deploy:chicken": "wrangler deploy --config wrangler.chicken.jsonc",
    "check": "npm run check:number",
    "check:number": "node --check src/index.mjs && npm test && wrangler deploy --config wrangler.number.jsonc --dry-run",
    "check:chicken": "npm test && wrangler deploy --config wrangler.chicken.jsonc --dry-run",
    "test": "node --test test/rules.test.mjs test/room.test.mjs",
    "test:integration": "node --test test/integration.test.mjs",
    "start": "node src/node-server.mjs",
    "test:node": "NUMBER_TEST_BACKEND=node node --test test/integration.test.mjs test/node.test.mjs test/chicken.test.mjs",
    "test:chicken-worker": "CHICKEN_TEST_BACKEND=worker node --test test/chicken.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=24"
  }
}
