{
  "name": "chicken-multiplayer",
  "main": "src/chicken-worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://tiendu.github.io",
    "MAX_ROOMS": "5"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LOBBY",
        "class_name": "ChickenLobby"
      },
      {
        "name": "ROOMS",
        "class_name": "ChickenRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ChickenLobby",
        "ChickenRoom"
      ]
    }
  ],
  "observability": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "CREATE_LIMIT",
      "namespace_id": "1101",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "CONNECT_LIMIT",
      "namespace_id": "1102",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
