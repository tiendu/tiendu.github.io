+++ b/src/components/games/MinesGame.astro
@@ -1,5 +1,6 @@
 ---
 import "../../styles/components/mines.css";
+import "../../styles/components/mines-layout.css";
 import "../../styles/components/mines-markers.css";
 ---
 <main class="mines" data-backend={import.meta.env.PUBLIC_MINES_BACKEND_URL || ""}>
diff --git a/src/styles/components/mines-layout.css b/src/styles/components/mines-layout.css
new file mode 100644
--- /dev/null
+++ b/src/styles/components/mines-layout.css
@@ -0,0 +1,90 @@
+/* MINES layout cleanup — game rules, tile artwork and movement stay unchanged.
+   New standalone sheet to avoid growing the existing >500-line CSS files. */
+.mines #field > .actions {
+  display: flex;
+  align-items: center;
+  justify-content: flex-start;
+  flex-wrap: wrap;
+  box-sizing: border-box;
+  gap: 8px 10px;
+  max-width: 100%;
+  width: min(100%, 860px);
+  margin: 8px auto 12px;
+  padding: 9px 10px;
+  border: 2px solid #52695a;
+  border-top-color: #748779;
+  border-right-color: #29382f;
+  border-bottom-color: #29382f;
+  background: #18221c;
+  box-shadow: inset 0 0 0 2px #111a15, 0 3px 0 #070e0a;
+}
+.mines #field > .actions > button {
+  flex: 0 0 auto;
+  box-sizing: border-box;
+  min-height: 42px;
+  padding: 6px 12px;
+  white-space: nowrap;
+}
+.mines #field > .actions #dig,
+.mines #field > .actions #flag {
+  min-width: 75px;
+  text-align: center;
+}
+.mines #field > .actions #fuses {
+  flex: 1 1 190px;
+  min-width: 0;
+  margin-inline-start: auto;
+  color: #f2d274;
+  font-size: clamp(13px, 1.8vw, 17px);
+  line-height: 1.3;
+  letter-spacing: 0;
+  white-space: normal;
+  overflow-wrap: normal;
+}
+.mines #field > .actions #locate-fuse {
+  flex: 0 0 auto;
+  min-height: 42px;
+  padding: 6px 10px;
+  font-size: clamp(13px, 1.7vw, 17px);
+  background: #304139;
+  border-color: #809284 #25332b #25332b #809284;
+  color: #e5e6d8;
+  white-space: nowrap;
+}
+.mines #field > .actions #pass:not([hidden]) { margin-inline-end: 4px; }
+/* Hug the rendered grid instead of stretching an outline across empty space.
+   On small screens retain the existing scrollable viewport behavior. */
+.mines #field > #viewport {
+  display: block;
+  box-sizing: border-box;
+  width: fit-content;
+  max-width: 100%;
+  min-width: 0;
+  margin: 10px auto;
+  padding: 6px;
+  overflow: auto;
+  overscroll-behavior: contain;
+  background: #0b1410;
+  border: 3px solid #53695a;
+  border-top-color: #879b86;
+  border-left-color: #879b86;
+  border-bottom-color: #27392e;
+  border-right-color: #27392e;
+  box-shadow: inset 0 0 0 2px #18251c, 0 3px 0 #080e0a;
+}
+.mines #field > #viewport #tiles {
+  width: max-content;
+  max-width: none;
+}
+@media (max-width: 640px) {
+  .mines #field > .actions { gap: 6px 8px; padding: 8px; }
+  .mines #field > .actions > button { min-height: 44px; padding-inline: 11px; }
+  .mines #field > .actions #fuses {
+    order: 5;
+    flex: 1 1 180px;
+    margin-inline-start: 0;
+    font-size: 14px;
+  }
+  .mines #field > .actions #locate-fuse { order: 6; font-size: 14px; }
+  .mines #field > #viewport { padding: 4px; margin-block: 8px; }
+}
